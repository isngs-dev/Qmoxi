# Public site URL — used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.qmoxi.com

# ── Contact form delivery ────────────────────────────────────────────────
# Configure at least ONE channel. With neither set, /api/contact returns
# 503 "not_configured" and the form tells visitors to email/call instead.

# Option A — email via Resend (https://resend.com). The FROM domain must be verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Qmoxi Website <website@qmoxi.com>"
# Comma-separated list of recipients. Defaults to brad.holdgreve@qmoxi.com.
CONTACT_TO_EMAIL=brad.holdgreve@qmoxi.com

# Option B — POST JSON to a CRM / automation webhook (HubSpot, Zapier, Make, n8n …).
CONTACT_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
CONTACT_WEBHOOK_SECRET=
